{
  "name": "@jgdina/core",
  "version": "1.0.0-rc.1",
  "description": "Environment-neutral types, validation, and orchestration for jGDINA.",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "SOURCE.md",
    "tsconfig.json",
    "tsconfig.source.json",
    "LICENSE",
    "NOTICE",
    "UPSTREAM.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "build:source": "npm run build",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/package-license.mjs prepare .",
    "postpack": "node ../../scripts/package-license.mjs clean .",
    "test": "vitest run --config ../../vitest.config.ts packages/core/test",
    "typecheck": "tsc --noEmit -p tsconfig.workspace.json"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
