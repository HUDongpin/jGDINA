{
  "name": "@jgdina/node",
  "version": "1.0.0-rc.1",
  "description": "Node worker_threads execution and pooling for standalone jGDINA.",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": ["./dist/index.js", "./dist/cjs.cjs", "./dist/worker-entry.js", "./dist/worker-entry.cjs"],
  "files": ["dist", "src", "scripts", "README.md", "SOURCE.md", "tsconfig.json", "tsconfig.source.json", "LICENSE", "NOTICE", "UPSTREAM.md"],
  "main": "./dist/cjs.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker-entry.ts --format esm --dts --sourcemap --clean --splitting && tsup src/cjs.ts src/worker-entry.ts --format cjs --sourcemap --splitting && node scripts/normalize-source-maps.mjs",
    "build:source": "npm run build",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/package-license.mjs prepare .",
    "postpack": "node ../../scripts/package-license.mjs clean .",
    "test": "vitest run --config ../../vitest.config.ts packages/node/test",
    "typecheck": "tsc --noEmit -p tsconfig.workspace.json"
  },
  "dependencies": {
    "@jgdina/core": "1.0.0-rc.1",
    "@jgdina/kernels-js": "1.0.0-rc.1",
    "@jgdina/worker-protocol": "1.0.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
